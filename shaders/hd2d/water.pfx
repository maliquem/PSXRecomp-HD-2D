pfx 1
# Water: the scenery and the sprites mirrored about the shore, gentle ripples and
# glints, on the 3D pixels painted in the game's water colours (the `water` input,
# listed by the game with gl_renderer_set_water_texels; empty list = no water).
# Live tuning (TCP post_uniform): u_water "strength ripple shimmer reach",
# u_wave "speed length 0 0".
# A game may set u_water itself (BoF4: bof4_video_menu.c, from its Water level):
# then the u_water line below is only the default for tests.
pass water
  shader water.glsl
  input u_src source
  input u_w water
  input u_m mask3d
  uniform u_water 0.45 1.2 0.35 0.45
  uniform u_wave 1.5 9 0 0
