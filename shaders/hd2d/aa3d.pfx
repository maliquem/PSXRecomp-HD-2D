pfx 1
# Anti-aliasing of the 3D geometry only (edges found in the PGXP depth; sprites,
# HUD, menus and texture detail untouched). Needs 3D Fix (PGXP depth).
# Live: post_uniform u_aa "0.04 0.004 1 1" shows the edges it smooths in red.
pass aa
  shader aa3d.glsl
  input u_src source
  input u_d depth
  input u_m mask3d
  uniform u_aa 0.04 0.004 1 0
