pfx 1
# Light from the game's own sources: what the
# framework marks as glowing (magic, fire, lamps) lights the 3D scenery near it
# in 3D, from the PGXP depth, and the sprites standing there (the `sprite`
# input), with a flame's flicker. Needs 3D Fix. Live tuning (TCP post_uniform):
# u_light "reach strength tint 0", u_lspr "sprites 0 0 0", u_flicker "amount
# pace 0 0", u_lightview "1 0 0 0" shows the light alone.
pass emit
  shader light-emit.glsl
  input u_src source
  input u_m mask
  input u_d depth
  lines 60
  format rgba16f
pass bh
  shader light-blur.glsl
  input u_tex previous
  lines 60
  format rgba16f
  uniform u_dir 1 0
pass bv
  shader light-blur.glsl
  input u_tex previous
  lines 60
  format rgba16f
  uniform u_dir 0 1
pass gather
  shader light-gather.glsl
  input u_e previous
  input u_d depth
  input u_spr sprite
  input u_m3 mask3d
  lines 240
  format rgba16f
  uniform u_light 40 1.0 0.15 0
  uniform u_proj 1024 240 8 0
pass gh
  shader light-blur.glsl
  input u_tex previous
  lines 240
  format rgba16f
  uniform u_dir 1 0
pass gv
  shader light-blur.glsl
  input u_tex previous
  lines 240
  format rgba16f
  uniform u_dir 0 1
# the shafts through the windows placed by hand (u_shaft x: 0 off, 1 Low,
# 2 High; it reads the fire map only for the lights' uniforms)
pass shaft
  shader shaft.glsl
  input u_d depth
  input u_spr sprite
  input u_fm firemap
  input u_wmask winmask
  lines 240
  format rgba16f
  uniform u_proj 1024 240 8 0
  uniform u_firecfg 900 48 0.55 10
  uniform u_firecol 1.0 0.65 0.35 2.2
  uniform u_placed 0 0 0 0
  uniform u_shaft 0 0 0 0
pass shh
  shader light-blur.glsl
  input u_tex previous
  lines 240
  format rgba16f
  uniform u_dir 1 0
pass shv
  shader light-blur.glsl
  input u_tex previous
  lines 240
  format rgba16f
  uniform u_dir 0 1
pass out
  shader light-out.glsl
  input u_src source
  input u_l gv
  input u_sh shv
  input u_m3 mask3d
  input u_spr sprite
  input u_d depth
  input u_fm firemap
  input u_wmask winmask
  uniform u_light 40 1.0 0.15 0
  uniform u_lightview 0 0 0 0
  uniform u_proj 1024 240 8 0
  # the fire lights: reach (world units), how far over its base a flame's light
  # sits, how much its shadow darkens, how soft its edges (world units); and its
  # colour (rgb, strength)
  uniform u_firecfg 900 48 0.55 10
  uniform u_firecol 1.0 0.65 0.35 2.2
  # the sprites lit too (strength), and a flame's flicker (amount, pace)
  uniform u_lspr 1 0 0 0
  uniform u_flicker 0.25 1 0 0
  # the lights placed by hand per area (area_lights.txt, the sun tool's Lights tab): x 1 = on
  uniform u_placed 0 0 0 0
  # the shafts through the windows placed by hand: x 0 off, 1 Low, 2 High
  uniform u_shaft 0 0 0 0
  # the room around a beam: bounce, ambient, the beam's strength, the bounce's reach
  uniform u_wind 4.5 0.58 2.4 170
  # the window itself shining: its openings, its halo on the wall, the halo's reach
  uniform u_wglow 1.0 1.4 70 0
